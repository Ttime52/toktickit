// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tickets Ticket[]

  @@index([isActive, name])
  @@map("categories")
}

model User {
  id                 Int       @id @default(autoincrement())
  displayName        String
  email              String    @unique
  passwordHash       String    @db.Text
  role               UserRole  @default(REQUESTER)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  ticketsRequested      Ticket[]        @relation("TicketRequester")
  ticketsOwned          Ticket[]        @relation("TicketOwner")
  resolutionIndications Ticket[]        @relation("RequesterResolutionIndication")
  uploadedAttachments   Attachment[]    @relation("AttachmentUploadedByUser")
  removedAttachments    Attachment[]    @relation("AttachmentRemovedByUser")
  publicComments        PublicComment[] @relation("PublicCommentAuthor")
  internalNotes         InternalNote[]  @relation("InternalNoteAuthor")
  actionsTakenPerformed ActionTaken[]   @relation("ActionTakenPerformedBy")
  actionsTakenUpdated   ActionTaken[]   @relation("ActionTakenUpdatedBy")
  actionTakenIdempotencyRecords ActionTakenIdempotency[] @relation("ActionTakenIdempotencyActor")
  sessions              Session[]

  @@index([role, isActive, displayName])
  @@index([role, isActive, email])
  @@map("users")
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tickets Ticket[]

  @@index([isActive, name])
  @@map("related_systems")
}

model Ticket {
  id                                   Int               @id @default(autoincrement())
  ticketNumber                         String            @unique
  ticketDate                           DateTime
  requesterId                          Int
  categoryId                           Int
  relatedSystemId                      Int
  summary                              String
  description                          String
  requestedPriority                    RequestedPriority @default(MEDIUM)
  itPriority                           ItPriority
  currentStatus                        CurrentStatus     @default(NEW)
  assignedToUserId                     Int?
  assignedAt                           DateTime?
  requesterResolutionIndicatedAt       DateTime?
  requesterResolutionIndicatedByUserId Int?
  idempotencyKey                       String            @unique
  version                              Int               @default(1)
  resolvedAt                           DateTime?         @db.Timestamptz(3)
  closedAt                             DateTime?         @db.Timestamptz(3)
  cancelledAt                          DateTime?         @db.Timestamptz(3)
  resolutionSummary                    String?           @db.Text
  closureSummary                       String?           @db.Text
  cancelReason                         String?           @db.Text
  reopenReason                         String?           @db.Text
  createdAt                            DateTime          @default(now())
  updatedAt                            DateTime          @default(now()) @updatedAt

  requester             User            @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  category              Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  relatedSystem         RelatedSystem   @relation(fields: [relatedSystemId], references: [id], onDelete: Restrict)
  assignedTo            User?           @relation("TicketOwner", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  requesterResolutionBy User?           @relation("RequesterResolutionIndication", fields: [requesterResolutionIndicatedByUserId], references: [id], onDelete: SetNull)
  attachments           Attachment[]
  publicComments        PublicComment[]
  internalNotes         InternalNote[]
  actionsTaken          ActionTaken[]
  actionTakenIdempotencyRecords ActionTakenIdempotency[]

  @@index([requesterId, updatedAt])
  @@index([requesterId, currentStatus])
  @@index([requesterId, categoryId])
  @@index([requesterId, relatedSystemId])
  @@index([requesterId, requestedPriority])
  @@index([assignedToUserId, updatedAt])
  @@index([assignedToUserId, currentStatus])
  @@index([currentStatus, updatedAt])
  @@index([itPriority, updatedAt])
  @@index([itPriority, currentStatus])
  @@index([resolvedAt])
  @@map("tickets")
}

model ActionTaken {
  id       BigInt @id @default(autoincrement())
  ticketId Int

  // Issue 23 names these fields actionDateTime, description, and performedById.
  // The @map values retain the canonical Lab 4 API/database column names.
  actionDateTime   DateTime @map("actionAt") @db.Timestamptz(3)
  description      String   @map("actionDescription") @db.Text
  result           String   @db.Text
  performedById    Int      @map("performedByUserId")
  followUpRequired Boolean
  followUpNote     String?  @db.Text
  attachmentNotes  String?  @db.Text

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  updatedById Int?     @map("updatedByUserId")
  version     Int      @default(1)
  seedKey     String?  @unique @db.VarChar(120)

  ticket      Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  performedBy User   @relation("ActionTakenPerformedBy", fields: [performedById], references: [id], onDelete: Restrict)
  updatedBy   User?  @relation("ActionTakenUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  idempotencyRecord ActionTakenIdempotency?

  @@index([ticketId, actionDateTime, id])
  @@index([ticketId, followUpRequired])
  @@index([performedById, actionDateTime])
  @@map("actions_taken")
}

model ActionTakenIdempotency {
  scope         String   @db.VarChar(80)
  key           String   @db.VarChar(64)
  actorId       Int      @map("actorUserId")
  ticketId      Int
  payloadHash   String   @db.Char(64)
  actionId      BigInt   @map("actionTakenId")
  ticketVersion Int
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  actor      User        @relation("ActionTakenIdempotencyActor", fields: [actorId], references: [id], onDelete: Restrict)
  ticket     Ticket      @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actionTaken ActionTaken @relation(fields: [actionId], references: [id], onDelete: Restrict)

  @@id([scope, key])
  @@unique([actionId])
  @@index([actorId, scope])
  @@index([ticketId])
  @@map("action_taken_idempotency")
}

model TicketNumberCounter {
  year      Int @id
  nextValue Int @default(1)

  @@map("ticket_number_counters")
}

model Attachment {
  id                Int                    @id @default(autoincrement())
  ticketId          Int
  uploadedByUserId  Int
  originalFilename  String
  storageKey        String                 @unique
  mimeType          String
  sizeBytes         Int
  uploadedAt        DateTime               @default(now())
  availabilityState AttachmentAvailability @default(AVAILABLE)
  unavailableAt     DateTime?
  unavailableReason String?
  removedAt         DateTime?
  removedByUserId   Int?
  removalReason     String?

  ticket         Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  uploadedByUser User   @relation("AttachmentUploadedByUser", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  removedByUser  User?  @relation("AttachmentRemovedByUser", fields: [removedByUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, removedAt])
  @@index([ticketId, uploadedAt])
  @@map("attachments")
}

model Session {
  id         String    @id @db.VarChar(128)
  userId     Int
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("sessions")
}

model LoginThrottleBucket {
  keyHash       String   @id @db.VarChar(128)
  failedCount   Int
  firstFailedAt DateTime
  blockedUntil  DateTime

  @@map("login_throttle_buckets")
}

model PublicComment {
  id           Int      @id @default(autoincrement())
  ticketId     Int
  authorUserId Int
  content      String   @db.Text
  createdAt    DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author User   @relation("PublicCommentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt, id])
  @@map("public_comments")
}

model InternalNote {
  id           Int      @id @default(autoincrement())
  ticketId     Int
  authorUserId Int
  content      String   @db.Text
  createdAt    DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author User   @relation("InternalNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt, id])
  @@map("internal_notes")
}

enum UserRole {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CurrentStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum ItPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AttachmentAvailability {
  AVAILABLE
  UNAVAILABLE
}
